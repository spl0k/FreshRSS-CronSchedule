<?php
declare(strict_types=1);
/** @var CronScheduleExtension $this */
$schedules = $this->schedules();
$now = time();
$h = static fn (string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
?>
<div class="post">
	<a href="<?= _url('extension', 'index') ?>"><?= _t('gen.action.back') ?></a>
	<h2><?= _t('ext.cron_schedule.title') ?></h2>
	<p><?= _t('ext.cron_schedule.intro') ?></p>

	<?php if ($this->errors !== []) { ?>
		<p class="alert alert-error"><?= _t('ext.cron_schedule.invalid') ?></p>
	<?php } ?>

	<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post">
		<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

		<table>
			<thead>
				<tr>
					<th><?= _t('ext.cron_schedule.feed') ?></th>
					<th><?= _t('ext.cron_schedule.expression') ?></th>
					<th><?= _t('ext.cron_schedule.next') ?></th>
				</tr>
			</thead>
			<tbody>
			<?php foreach ($this->feeds() as $feed) {
				$id = (string)$feed->id();
				$hasError = isset($this->errors[$id]);
				$value = $hasError ? $this->errors[$id] : ($schedules[$id] ?? '');
				$cron = ($value !== '' && !$hasError) ? $this->cron($value) : null;
				$next = $cron?->next($now);
				$category = $this->categoryName($feed);
			?>
				<tr>
					<td>
						<?= $h($feed->name()) ?>
						<?php if ($category !== '') { ?><small>(<?= $h($category) ?>)</small><?php } ?>
					</td>
					<td>
						<input type="text" name="cron[<?= $h($id) ?>]" value="<?= $h($value) ?>"
							placeholder="0 7 * * 1-5" size="22" spellcheck="false" autocomplete="off"
							<?= $hasError ? 'aria-invalid="true" style="border-color:#c0392b"' : '' ?> />
						<?php if ($hasError) { ?><small>⚠ <?= _t('ext.cron_schedule.invalid_one') ?></small><?php } ?>
					</td>
					<td><?= $next !== null ? $h(date('D d/m/Y H:i', $next)) : '—' ?></td>
				</tr>
			<?php } ?>
			</tbody>
		</table>

		<div class="form-group form-actions">
			<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
			<button type="reset" class="btn"><?= _t('gen.action.cancel') ?></button>
		</div>
	</form>

	<h3><?= _t('ext.cron_schedule.help_title') ?></h3>
	<?= _t('ext.cron_schedule.help') ?>
</div>
